{
  "name": "momentum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"npm:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.momentum.app",
    "productName": "Momentum",
    "files": [
      "dist/**",
      "electron/**/*",
      "package.json"
    ],
    "icon": "public/Momentum.ico",
    "asar": false,
    "directories": {
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Momentum OAuth Callback",
        "schemes": ["momentum"]
      }
    ],
    "win": {
      "target": ["portable"],
      "forceCodeSigning": false,
      "cscLink": null,
      "icon": "public/Momentum.ico"
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "open": "^11.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
